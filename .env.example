# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# PayPal REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave empty to run in MOCK mode (fake payments, no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live   # default is sandbox

# Where PayPal sends the payer after approving. Use your deployed URL.
PUBLIC_URL=http://localhost:3000

DEFAULT_CURRENCY=GBP
MAX_PAYMENT=500
# SETTLE_MODEL=claude-opus-5-5

# Slack (see "Slack" in README.md). Bot token starts xoxb-, app-level token starts xapp-.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
